node_modules/
.env
.env.*
!.env.example
.DS_Store

# Private/raw source material and per-project DeepSeek Harness runtime state.
# Only the policy README and reviewed portable history snapshots may be tracked.
**/.sdd/*
!**/.sdd/README.md
!**/.sdd/history/
!**/.sdd/history/**

# The public repository keeps normalized source facts, never the source PDFs.
*.pdf
!catalog-consolidation-vtex.pdf
!engine-sdd-deepseek-harness.pdf

# Local copies of assessment fixtures are reproducibly downloaded on demand.
ProductEntry.json
catalog.db
*.db-journal
*.db-wal
*.db-shm

# Product implementation outputs created by later SDD runs.
coverage/
dist/
