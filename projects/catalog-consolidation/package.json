{
  "name": "@sdd-project/catalog-consolidation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sources:ingest": "npm --prefix ../../engine run sources:ingest -- --project catalog-consolidation",
    "sdd:prepare": "npm --prefix ../../engine run sdd:prepare -- --project catalog-consolidation",
    "sdd:run": "npm --prefix ../../engine run sdd:run -- --project catalog-consolidation",
    "sdd:validate": "npm --prefix ../../engine run sdd:validate -- --project catalog-consolidation",
    "cost:record": "npm --prefix ../../engine run cost:record -- --project catalog-consolidation",
    "cost:report": "npm --prefix ../../engine run cost:report -- --project catalog-consolidation",
    "build": "tsc --project tsconfig.json",
    "demo:feature": "npm run build && node scripts/demo-feature.mjs",
    "test": "npm run build && node --test test/*.test.mjs test/hc-*.test.ts",
    "test:fixture": "npm run build && node --test test/sdd-consolidation-idempotency.test.mjs",
    "check": "npm test && npm run sdd:validate"
